{
  "name": "families-data",
  "productName": "Families Data",
  "version": "0.3.0",
  "description": "Offline family data management and aid distribution (Arabic / English / Armenian)",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis portable"
  },
  "author": "Families Data",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "sql.js": "^1.12.0",
    "xlsx": "^0.18.5",
    "zxing-wasm": "1.3.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.familiesdata.app",
    "productName": "Families Data",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Families Data"
    }
  }
}
